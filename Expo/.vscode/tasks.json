{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "expo-web",
      "type": "shell",
      "command": "npx expo start --web",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "endsPattern": "Waiting on|Logs for"
        }
      }
    }
  ]
}
